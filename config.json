{
  "upload_limits": {
    "max_file_size_mb": 256,
    "max_request_size_mb": 512
  },
  "common_input_columns": {
    "log": ["Task_Name", "Timestamp"]
  },

  "input_specs": {
    "show_files": {
      "label": "グラフ表示",
      "description": "表示したい CSV または Excel ファイルを選択してください．",
      "fixed_files": [],
      "file_rules": [],
      "log_policy": "optional",
      "log_columns_ref": "common_input_columns.log"
    },
    "mlx_evaluation": {
      "label": "MLX評価",
      "description": "体温真値 CSV と MLX 計測 CSV／Excel を使用します．",
      "fixed_files": [
        {"name": "body_temperature.csv", "label": "体温真値 CSV", "min_columns": 2}
      ],
      "file_rules": [
        {
          "label": "MLX計測ファイル",
          "selection": "filename",
          "min_count": 1,
          "max_count": 1,
          "extensions": [".csv", ".xlsx", ".xls"],
          "contains_any": ["mlx", "3-device_measurement"],
          "min_columns": 8,
          "sheet_candidates_ref": "mlx_sheet_candidates"
        }
      ],
      "log_policy": "optional",
      "log_columns_ref": "common_input_columns.log"
    },
    "max_evaluation": {
      "label": "MAX評価",
      "description": "ECG，PPG，Fin PPG の各 CSV を使用します．",
      "fixed_files": [
        {"name": "ecg.csv", "label": "ECG CSV", "columns_ref": "max_columns.ecg"},
        {"name": "PPG_BPM.csv", "label": "PPG BPM CSV", "columns_ref": "max_columns.ppg_bpm"},
        {"name": "PPG_fin_BPM.csv", "label": "Fin PPG BPM CSV", "columns_ref": "max_columns.ppg_bpm"}
      ],
      "file_rules": [],
      "log_policy": "optional",
      "log_columns_ref": "common_input_columns.log"
    },
    "mlx_reevaluation": {
      "label": "MLX修正後評価",
      "description": "体温真値 CSV と mlx_re.csv を使用します．",
      "fixed_files": [
        {"name": "body_temperature.csv", "label": "体温真値 CSV", "min_columns": 2},
        {"name": "mlx_re.csv", "label": "修正後 MLX CSV", "min_columns": 9}
      ],
      "file_rules": [],
      "log_policy": "optional",
      "log_columns_ref": "common_input_columns.log"
    },
    "ppg_to_hr": {
      "label": "PPG→HR変換",
      "description": "加速度を含む PPG 生データ CSV を 1 つ使用します．",
      "fixed_files": [],
      "file_rules": [
        {
          "label": "PPG生データ CSV",
          "selection": "columns",
          "min_count": 1,
          "max_count": 1,
          "extensions": [".csv"],
          "exclude_contains": ["_log.csv"],
          "columns_ref": "ppg_columns.raw_csv"
        }
      ],
      "log_policy": "unused"
    },
    "ppg_analysis": {
      "label": "PPG解析",
      "description": "HR_BPM を含む *_HR.csv を 2 つ以上使用します．",
      "fixed_files": [],
      "file_rules": [
        {
          "label": "HRデータ CSV",
          "selection": "filename",
          "min_count": 2,
          "extensions": [".csv"],
          "suffix": "_hr.csv",
          "columns_ref": "ppg_columns.hr_csv"
        }
      ],
      "log_policy": "optional",
      "log_columns_ref": "common_input_columns.log"
    },
    "ppg_hr_analysis": {
      "label": "PPG脈波解析",
      "description": "IR_Value と RecvJST を含む CSV を 1 つ以上使用します．",
      "fixed_files": [],
      "file_rules": [
        {
          "label": "PPG脈波 CSV",
          "selection": "columns",
          "min_count": 1,
          "extensions": [".csv"],
          "exclude_contains": ["_log.csv"],
          "columns_ref": "ppg_columns.wave_csv"
        }
      ],
      "log_policy": "optional",
      "log_columns_ref": "common_input_columns.log"
    },
    "ppg_acc_analysis": {
      "label": "PPG＋ACC解析",
      "description": "Fin と耳たぶの PPG 生データ CSV を各 1 つ使用します．",
      "fixed_files": [],
      "file_rules": [
        {
          "label": "Fin PPG生データ CSV",
          "selection": "columns",
          "min_count": 1,
          "max_count": 1,
          "extensions": [".csv"],
          "contains_all": ["fin"],
          "exclude_contains": ["_log.csv"],
          "columns_ref": "ppg_columns.raw_csv"
        },
        {
          "label": "耳たぶ PPG生データ CSV",
          "selection": "columns",
          "min_count": 1,
          "max_count": 1,
          "extensions": [".csv"],
          "exclude_contains": ["fin", "_log.csv"],
          "columns_ref": "ppg_columns.raw_csv"
        }
      ],
      "log_policy": "required",
      "log_columns_ref": "common_input_columns.log"
    }
  },

  "mlx_sheet_candidates": [
    "MLX_L mini",
    "MLX_L",
    "MLX_R mini",
    "MLX_R"
  ],

  "mlx_evaluation_file_candidates": [
    "3-Device_Measurement.xlsx"
  ],

  "mlx_evaluation_filename_keywords": [
    "mlx"
  ],

  "mlx_columns": {
    "normal_csv": {
      "ambient": 0,
      "object": 1,
      "elapsed_ms": 4,
      "recvjst": 7,
      "min_columns": 8
    },
    "normal_xlsx": {
      "ambient": 0,
      "object": 1,
      "elapsed_ms": 4,
      "offset_col_letter": "F",
      "recvjst_col_letter": "H",
      "min_columns": 8
    },
    "corrected_csv": {
      "ambient": 0,
      "object": 8,
      "elapsed_ms": 4,
      "offset_s": 5,
      "recvjst": 7,
      "min_columns": 9
    }
  },

  "max_columns": {
  "ecg": {
    "time": "Timestamp",
    "hr": "HeartRate_BPM"
  },
  "ppg_bpm": {
    "time": "RecvJST",
    "hr": "HR_BPM"
  }
},

"ppg_columns": {
  "hr_csv": {
    "time": "RecvJST",
    "hr": "HR_BPM"
  },
  "raw_csv": {
    "time": "RecvJST",
    "ir": "IR_Value",
    "red": "RED_Value",
    "accel_x": "Accel_X_mg",
    "accel_y": "Accel_Y_mg",
    "accel_z": "Accel_Z_mg",
    "elapsed_ms": "SensorElapsed_ms"
  },
  "wave_csv": {
    "time": "RecvJST",
    "ir": "IR_Value"
  }
},

  "task_names": ["順応(５分)", "安静状態の測定(５分)","安静状態の測定(１０分)", "朗読(１分)", "準備(３０秒)", "4km/h（３分）",
                      "6km/h（３分）", "トレッドミルへ移動・準備(２分)",
                      "トレッドミル歩行 4km/h(５分)", "安静状態の測定(１５分)", "トレッドミル早歩き 6km/h(５分)",
                      "椅子へ移動・準備(３０秒)", "回復状態の測定(５分)", 
                      "安静状態の測定(１/１５分)", "安静状態の測定(２/１５分)", "安静状態の測定(３/１５分)", 
                      "安静状態の測定(４/１５分)", "安静状態の測定(５/１５分)", "安静状態の測定(６/１５分)", 
                      "安静状態の測定(７/１５分)", "安静状態の測定(８/１５分)", "安静状態の測定(９/１５分)", 
                      "安静状態の測定(１０/１５分)", "安静状態の測定(１１/１５分)", "安静状態の測定(１２/１５分)", 
                      "安静状態の測定(１３/１５分)", "安静状態の測定(１４/１５分)", "安静状態の測定(１５/１５分)",
                      "安静状態の測定(１/１０分)", "安静状態の測定(２/１０分)", "安静状態の測定(３/１０分)", 
                      "安静状態の測定(４/１０分)", "安静状態の測定(５/１０分)", "安静状態の測定(６/１０分)", 
                      "安静状態の測定(７/１０分)", "安静状態の測定(８/１０分)", "安静状態の測定(９/１０分)", 
                      "安静状態の測定(１０/１０分)",
                      "安静手で覆う(６分)", "安静(５分)", "安静(４分)","実験終了"
                    ]
}
